{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://checkout.culqi.com https://js.culqi.com; style-src 'self' 'unsafe-inline' https://checkout.culqi.com; font-src 'self'; img-src 'self' data: https: blob:; connect-src 'self' https://lggxsejjbhkymazgalzm.supabase.co wss://lggxsejjbhkymazgalzm.supabase.co https://api.culqi.com https://secure.culqi.com https://checkout.culqi.com https://js.culqi.com; frame-src https://checkout.culqi.com https://js.culqi.com https://secure.culqi.com https://3ds.culqi.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://lggxsejjbhkymazgalzm.supabase.co https://accounts.google.com; object-src 'none'"
        }
      ]
    },
    {
      "source": "/tienda/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(|index.html|tienda/|tienda/index.html|privacidad.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=3600"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tienda/index.html",
      "destination": "/tienda/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/tienda/p/(.*)",
      "destination": "/tienda/ficha.html"
    }
  ]
}